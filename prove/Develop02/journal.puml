@startuml journal

class Journal 
{
    - entries : List<Entry>
    - prompts : List<string>

    + addEntry()
    + displayEntries()
    + saveToFile()
    + loadFromFile()
}

class Entry
{
    - date : string
    - prompt : string
    - response : string
}

class RandomPrompt
{
    + getRandomPrompt()
}

Program --> Journal
Journal --> Entry
Entry --> RandomPrompt

@enduml